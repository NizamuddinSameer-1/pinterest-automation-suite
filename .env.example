# ── App ──────────────────────────────────────────
APP_ENV=development

# ── Database ─────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/pre.db

# ── Storage ──────────────────────────────────────
STORAGE_PATH=./data

# ── OpenCode AI (Primary Provider) ───────────────
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://api.opencode.ai/v1
OPENCODE_TEXT_MODEL=deepseek-v4-flash
OPENCODE_VISION_MODEL=mimo-v2.5

# ── Fallback Providers (Optional) ────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat-v4-0324

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── NVIDIA NIM (Alternative OpenAI-compatible Provider) ──
# Free tier: 40 RPM, supports meta/llama-3.2-11b-vision-instruct, DeepSeek, etc.
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# ── Content Lane (Lane 2: blogs, pins, SEO, post copy) ──
# Dedicated key set so editorial calls never starve reference/vision/prompts.
# Empty = fall back to the primary keys above (single-key setups unaffected).
CONTENT_NVIDIA_API_KEY=
CONTENT_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
CONTENT_NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

CONTENT_OPENCODE_API_KEY=
CONTENT_OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1
CONTENT_OPENCODE_TEXT_MODEL=deepseek-v4-flash
CONTENT_OPENCODE_VISION_MODEL=mimo-v2.5

CONTENT_OPENROUTER_API_KEY=
CONTENT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CONTENT_OPENROUTER_MODEL=deepseek/deepseek-chat-v4-0324

CONTENT_GEMINI_API_KEY=
CONTENT_GEMINI_MODEL=gemini-2.0-flash
CONTENT_GEMINI_VISION_MODEL=gemini-2.0-flash

# ── Pinterest API (Phase 3 — leave empty) ────────
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_ACCESS_TOKEN=

# ── Google Flow (browser automation) ─────────────
# ── Optional Free Cloud GPU AI Upscaler (Google Colab / Cloudflare) ──
# Leave empty to use the local Lanczos resize (0% RAM / 0% GPU).
# Option 1: Provide your saved notebook link (Playwright opens Colab, switches to T4 GPU & runs automatically):
COLAB_NOTEBOOK_URL=
# Option 2: Or directly paste an active Colab tunnel URL (e.g. https://xyz.trycloudflare.com):
COLAB_UPSCALER_URL=

# ── Pin enhancement (all optional; defaults shown) ───────────────
# These are read by app/services/anti_ai_processor.py. Every stage is
# idempotent, so an image can never be cropped or sharpened twice.
#
# Pinterest pin width. Acts as a ceiling: larger images are downscaled to it.
UPSCALER_TARGET_WIDTH=1080
# q92 4:2:0 is visually lossless at pin display sizes and ~3x smaller than q98 4:4:4.
UPSCALER_JPEG_QUALITY=92
UPSCALER_SUBSAMPLING=2
# Fraction of the render height kept after removing the Flow sparkle, which sits
# at y 0.912-0.946. 0.910 clears it with a small margin.
WATERMARK_KEEP_FRACTION=0.910
# Cap the GPU upscaler's 4x output before it crosses the tunnel.
COLAB_MAX_OUTPUT_PX=2160
# Luminance-only unsharp mask. The threshold protects flat areas (skin, sky,
# flat colour) from being sharpened; the old value of 1 sharpened every pixel.
UGC_SHARPEN_PERCENT=60
UGC_SHARPEN_RADIUS=1.0
UGC_SHARPEN_THRESHOLD=3
# Luminance-only sensor grain, to break AI plastic smoothness.
UGC_GRAIN_AMOUNT=1.5

# ── Vercel Edge Publisher ─────────────────────────
VERCEL_API_TOKEN=
VERCEL_PROJECT_NAME=pinterest-lookbooks
BRIDGE_DOMAIN=

# ── Git-Backed Lookbook Deployment (GitHub + Vercel) ──
# Optional: Set this to your GitHub repository remote to enable automatic Git push
# e.g., https://github.com/yourusername/pinterest-lookbooks.git or token URL
LOOKBOOK_GIT_REMOTE=
LOOKBOOK_GIT_BRANCH=main
LOOKBOOK_GIT_AUTO_PUSH=true
